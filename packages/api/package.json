{
  "name": "@flowers-tg/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "clean": "rm -rf dist",
    "db:push": "tsx src/infra/db/push.ts",
    "db:seed": "tsx src/infra/db/seed.ts",
    "db:setup": "tsx src/infra/db/push.ts && tsx src/infra/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@flowers-tg/shared": "workspace:*",
    "dotenv": "^16.4",
    "drizzle-orm": "^0.39",
    "fastify": "^5.2",
    "postgres": "^3.4",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@types/node": "^22",
    "drizzle-kit": "^0.30",
    "tsx": "^4.19",
    "typescript": "^5.7"
  }
}
