# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=Flowers_Shop_KU_bot
# Опционально: secret_token при setWebhook — Telegram шлёт заголовок X-Telegram-Bot-Api-Secret-Token
# TELEGRAM_WEBHOOK_SECRET=

# Shared secret: API → bot (/internal/notify) and bot → API (/api/users/*) in production.
# Generate: openssl rand -hex 32
INTERNAL_API_SECRET=
# URL бота для push-уведомлений о заказах (тот же хост, что слушает BOT_PORT)
BOT_NOTIFY_URL=http://localhost:3001/internal/notify
# Бот вызывает API (referral, first-order-promo)
API_BASE_URL=http://localhost:3000
BOT_PORT=3001

# Опционально: срок жизни initData в секундах (по умолчанию 900)
# INIT_DATA_MAX_AGE_SEC=900
# Опционально: TTL анти-replay по query_id (по умолчанию min(900, INIT_DATA_MAX_AGE_SEC), минимум 60)
# INIT_DATA_REPLAY_TTL_SEC=900

# Production: разрешённые Origin для CORS (через запятую), напр. https://ваш-мини-app.vercel.app
# В production CORS_ORIGIN обязателен (без него API не стартует).
# В dev без CORS_ORIGIN — разрешены все (origin: true).
# CORS_ORIGIN=https://your-mini-app.example

# Только для отладки: разрешить клиенту менять статус заказа через PATCH /orders/:id/status (в prod по умолчанию выкл.)
# ALLOW_USER_ORDER_STATUS_PATCH=true

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# LOG_LEVEL=info

# API rate limit (optional; defaults: 400 req / 60s per IP, /health excluded)
# RATE_LIMIT_MAX=400
# RATE_LIMIT_WINDOW_MS=60000

# Admin endpoints rate limit (optional; defaults: 30 req / 60s per IP)
# ADMIN_RATE_LIMIT_MAX=30
# ADMIN_RATE_LIMIT_WINDOW_MS=60000

# Admin API + веб-админка (/admin): тот же ключ в заголовке X-Admin-Secret при входе в приложении
# Generate: openssl rand -hex 32
ADMIN_API_SECRET=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowers_tg

# Redis
REDIS_URL=redis://localhost:6379
# Mini App
VITE_API_BASE_URL=http://localhost:3000
# Vite dev: прокси /api → backend (если API не на 3000, например порт занят)
# VITE_API_PROXY_TARGET=http://localhost:3002
VITE_BOT_USERNAME=Flowers_Shop_KU_bot

# Payments (YooKassa, M3)
# Тестовый магазин: shopId и секрет из личного кабинета YooKassa (раздел «Настройки» → «Ключи API»).
# Боевой магазин — отдельные ключи; не смешивайте в одном .env.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Опционально: нестандартный endpoint (по умолчанию https://api.yookassa.ru/v3)
# YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3

# Публичный URL Mini App (без слэша в конце) — для return_url после оплаты и согласования с CORS.
# Локально: http://localhost:5173
MINI_APP_PUBLIC_URL=http://localhost:5173

# В кабинете YooKassa укажите URL HTTP-уведомлений (webhook):
#   https://<ваш-api-домен>/api/webhooks/yookassa
# Проверка: после уведомления API запрашивает платёж у YooKassa (GET) — подпись тела не используется.
